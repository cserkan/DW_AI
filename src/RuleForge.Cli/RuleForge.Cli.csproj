<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net48: SolidWorks komutları dahil (Windows). net8.0: SolidWorks'süz komutlar (her platform, CI). -->
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <AssemblyName>ruleforge</AssemblyName>
    <RootNamespace>RuleForge.Cli</RootNamespace>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);SOLIDWORKS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RuleForge.Core\RuleForge.Core.csproj" />
    <ProjectReference Include="..\RuleForge.Inference\RuleForge.Inference.csproj" />
    <ProjectReference Include="..\RuleForge.AI\RuleForge.AI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Arayuz\index.html" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <ProjectReference Include="..\RuleForge.SolidWorks\RuleForge.SolidWorks.csproj" />
  </ItemGroup>
</Project>
